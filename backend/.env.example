# Скопіюй у backend/.env і заповни. Сам .env у git не потрапляє.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/court

# AI-шар (B). Ключ Google AI Studio для Gemma API.
GEMMA_API_KEY=
GEMMA_PROJECT_NAME="projects/146714526211"
GEMMA_PROJECT_NUMBER="146714526211"
GEMMA_API_NAME="Gemma API"
LLM_PROVIDER="gemma_api" # перемикач: "gemma_api" | "ollama" | "anthropic"
FAST_MODEL="gemma3:4b"   # теги Ollama (для LLM_PROVIDER=ollama)
MAIN_MODEL="gemma3:12b"
EMBED_MODEL="bge-m3"     # завжди локальна Ollama: ollama pull bge-m3

# Необов'язково (показано значення за замовчуванням)
# GEMMA_FAST_MODEL="gemma-4-26b-a4b-it"
# GEMMA_MAIN_MODEL="gemma-4-26b-a4b-it"      # gemma-4-31b-it: краща українська, ~30 с/виклик, часто 500/503
# GEMMA_SCHEMA_ROLES="prefilter,moderator"  # ролі зі schema-constrained виводом; "all" = усі
# TTS_ENABLED="1"
